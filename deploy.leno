// deploy.leno — 把 exe 推到目标机的 deployd 并重启（deploy.ps1 的 Leno 版）
// ----------------------------------------------------------------------------
// 为什么换掉 deploy.ps1：
//   · ps1 靠 curl.exe 分块传（4.4MB 实测 1.8s，WebNet 走 libcurl 只要 ~0.2s）；
//   · ps1 在 `curl` 卡住时**没有任何输出**，只能干等（实测被卡过几十分钟 ✗）；
//   · 这里每一步都带超时 + 明确成功/失败判定，失败立刻非零退出 ✓
//
// 用法（在 d:\CLeno\AriaDeployd 下跑）：
//   ..\Leno\build\leno.exe deploy.leno -exe d:\CLeno\Aria\server\dist\server.exe
//   ..\Leno\build\leno.exe deploy.leno -exe ... -health https://s4.v100.vip:5767/health
//   ..\Leno\build\leno.exe deploy.leno -uploadonly -exe dist\deployd.exe -dest D:\AriaServer\deployd_new.exe
//   ..\Leno\build\leno.exe deploy.leno -status
//   ..\Leno\build\leno.exe deploy.leno -logs -tail 30
//
// 流程：health → stop → upload(分块) → merge → start → 轮询 status
//   ⚠ upload 分块时**不能带 X-Name**：deployd 的 /upload 看到 name 就会杀进程 + 重新拉起，
//     每块都带 = 反复杀/启（实测会起一堆进程 ✗）⇒ 只有 merge 和最后 start 才带 name ✓
import "WebNet" as net
import "threads" as th
import sockets
import strings
import files
import dirs
import jsons
import times

// 每块 2MB（deployd 的 /upload 收 8MB 以内，旧版 4MB 也吃得下 ✓）
//   2026-11-13 之前用 WebNet 传时块大小很敏感（512KB 以上超线性、2MB 要 11 秒）；
//   WebNet 的根因已在 LenoWeb 修好（大 body 改走 read 回调，2MB 34ms），
//   这里仍用 sockets 是因为少一层 FFI 回调、代码更短（实测跨机 2MB 92ms）✓
const int    CHUNK     = 2000000
const string DEF_HOST  = "192.168.1.150"
const int    DEF_PORT  = 8899
const string DEF_DEST  = "D:\\AriaServer\\server.exe"
const string DEF_NAME  = "server.exe"

// ==================== 小工具 ====================

func has_ok(string s): bool { return s.has("\"ok\":true") }

// D:\a\b.exe → D:\a
func dir_of(string p): string {
    int i = p.len() - 1
    while i >= 0 {
        string ch = p.slice(i, i)
        if ch == "\\" or ch == "/" { return p.slice(0, i - 1) }
        i = i - 1
    }
    return "."
}

// token 默认从同目录的 deployd.json 读（本机 dist\deployd.json 是模板，值同目标机 ✓）
func load_token(): string {
    string base = _str(dirs.script_dir())
    string p = dirs.join(base, "dist\\deployd.json")
    if not files.exists(p) { p = dirs.join(base, "deployd.json") }
    if not files.exists(p) { return "" }
    try {
        var d = jsons.read_file(p) as Dict
        if d == null { return "" }
        return _str(d.get("token", ""))
    } catch e {
        return ""
    }
}

// ==================== 极简 HTTP 客户端（sockets 直发）====================
// 为什么不用 WebNet 传 exe：libcurl 的 POSTFIELDS 在 Windows 上发大 body 会退化成
//   小块慢发 —— 实测 2MB 要 11 秒，而同一次请求 **服务端 21ms 就收完了**
//   （服务端日志 `[perf] body 2097152B recv=32x in 21ms`）⇒ 瓶颈在客户端 libcurl。
//   deployd 就在内网、明文 HTTP、不需要重定向/gzip/分块 ⇒ 直接用 sockets 组一个
//   `POST /upload`，body 一次 send 出去，几 MB 也就几十毫秒 ✓
//   （https 的 healthUrl 仍回退 WebNet —— 那只是个几十字节的 GET，慢也无所谓 ✓）
func http_raw(string url, string method, string body, Array[string] hs, int ms): string {
    if url.has("https://") { return web_fallback(url, method, body, hs, ms) }
    string rest = url
    if rest.has("http://") { rest = rest.byte_slice(7, rest.byte_len() - 1) }
    int slash = strings.byte_find(rest, "/", 0)
    string hostport = if slash < 0 then rest else rest.byte_slice(0, slash - 1)
    string path = if slash < 0 then "/" else rest.byte_slice(slash, rest.byte_len() - 1)
    string hname = hostport
    int port = 80
    int colon = strings.byte_find(hostport, ":", 0)
    if colon >= 0 {
        hname = hostport.byte_slice(0, colon - 1)
        port = _int(hostport.byte_slice(colon + 1, hostport.byte_len() - 1))
    }
    Socket s = sockets.connect(hname, port)
    if s == null { return "" }
    s.set_timeout(ms)
    string head = method + " " + path + " HTTP/1.1\r\n"
    head = head + "Host: " + hostport + "\r\n"
    for hs to one { head = head + one + "\r\n" }
    // Content-Length 必须按**字节**给（二进制 body 用 strlen 会被截断）
    head = head + "Content-Length: " + _str(body.byte_len()) + "\r\nConnection: close\r\n\r\n"
    bool sent = s.send(head)
    if sent and body.byte_len() > 0 { sent = s.send(body) }
    if not sent { s.close(); return "" }
    // 读完整响应（服务端 Connection: close ⇒ 读到对端关闭为止）
    Array[string] parts = []
    while true {
        var chunk = s.recv(65536)
        if chunk == null { break }
        string seg = chunk as string
        if seg.byte_len() == 0 { break }
        parts.add(seg)
    }
    s.close()
    string raw = parts.join("")
    int he = strings.byte_find(raw, "\r\n\r\n", 0)
    if he < 0 or he + 4 > raw.byte_len() - 1 { return "" }
    return raw.byte_slice(he + 4, raw.byte_len() - 1)
}

// https / 需要 libcurl 能力的请求回退到 WebNet（只用于小请求）
func web_fallback(string url, string method, string body, Array[string] hs, int ms): string {
    var c = net.createClient()
    if not c.isOk() { return "" }
    c.setTimeout(ms)
    if hs.len() > 0 { c.addHeaders(hs) }
    var r = if method == "GET" then c.get(url) else c.post(url, body)
    c.close()
    return _str(r.body)
}

// 简易 GET（只取 body；连不上回 ""）
func http_get(string url, Array[string] hs, int ms): string {
    return http_raw(url, "GET", "", hs, ms)
}

// 简易 POST（body 可以是**二进制**）
func http_post(string url, string body, Array[string] hs, int ms): string {
    return http_raw(url, "POST", body, hs, ms)
}

// ==================== 主流程 ====================

main() {
    string host = DEF_HOST
    int    port = DEF_PORT
    string token = load_token()
    string exePath = ""
    string dest = DEF_DEST
    string name = DEF_NAME
    string startArgs = ""
    string healthUrl = ""
    bool   statusOnly = false
    bool   logsOnly = false
    bool   uploadOnly = false
    int    tail = 40

    var args = _args()
    int ai = 0
    while ai < args.len() {
        string a = _str(args[ai])
        string v = if ai + 1 < args.len() then _str(args[ai + 1]) else ""
        if a == "-host" and v != "" { host = v; ai = ai + 2 }
        eif a == "-port" and v != "" { port = _int(v); ai = ai + 2 }
        eif a == "-token" and v != "" { token = v; ai = ai + 2 }
        eif a == "-exe" and v != "" { exePath = v; ai = ai + 2 }
        eif a == "-dest" and v != "" { dest = v; ai = ai + 2 }
        eif a == "-name" and v != "" { name = v; ai = ai + 2 }
        eif a == "-args" { startArgs = v; ai = ai + 2 }
        eif a == "-health" and v != "" { healthUrl = v; ai = ai + 2 }
        eif a == "-tail" and v != "" { tail = _int(v); ai = ai + 2 }
        eif a == "-status" { statusOnly = true; ai = ai + 1 }
        eif a == "-logs" { logsOnly = true; ai = ai + 1 }
        eif a == "-uploadonly" { uploadOnly = true; ai = ai + 1 }
        else { ai = ai + 1 }
    }

    if token == "" {
        print("[FAIL] 没有 token：传 -token，或把 deployd.json 放在脚本/dist 目录")
        _exit(1)
    }
    string base = "http://" + host + ":" + _str(port)

    // ---- 只查状态 / 只看日志 ----
    if statusOnly {
        Array[string] hs = ["X-Token: " + token, "X-Name: " + name]
        print(http_get(base + "/status", hs, 8000))
        _exit(0)
    }
    if logsOnly {
        string lf = dir_of(dest) + "\\logs\\" + name + "." + times.format(times.now(), "%Y%m%d") + ".log"
        Array[string] hs = ["X-Token: " + token, "X-File: " + lf, "X-N: " + _str(tail)]
        print(http_get(base + "/logs", hs, 15000))
        _exit(0)
    }

    if exePath == "" {
        print("[FAIL] 缺少 -exe <本地 exe 路径>")
        _exit(1)
    }
    if not files.exists(exePath) {
        print("[FAIL] 本地文件不存在：" + exePath)
        _exit(1)
    }

    // ---- 1/5 deployd 存活 ----
    print("[1/5] deployd health")
    string h = http_get(base + "/health", [], 5000)
    if h == "" {
        print("      [FAIL] 连不上 " + base + "（目标机没开 deployd？）")
        _exit(1)
    }
    print("      " + h)

    // ---- 2/5 停旧进程（释放 exe 文件锁）----
    if not uploadOnly {
        print("[2/5] stop " + name)
        Array[string] hsStop = ["X-Token: " + token, "X-Name: " + name]
        print("      " + http_post(base + "/stop", "", hsStop, 15000))
    } else {
        print("[2/5] 跳过 stop（-uploadonly）")
    }

    // ---- 3/5 分块上传 ----
    string data = files.read(exePath)
    int total = data.byte_len()
    if total <= 0 {
        print("[FAIL] 读不到 exe 内容：" + exePath)
        _exit(1)
    }
    int parts = (total + CHUNK - 1) / CHUNK
    print("[3/5] upload " + _str(total) + " 字节 / " + _str(parts) + " 块")
    int t0 = _int(times.ms())
    for 0 : parts - 1 to i {
        int a = i * CHUNK
        int b = a + CHUNK - 1
        if b > total - 1 { b = total - 1 }
        string seg = data.byte_slice(a, b)
        Array[string] hs = ["X-Token: " + token, "X-To: " + dest]
        // ★ 单块时**不能**带 X-Part：deployd 见到 part 会写到 <dest>.partN，而单块又不 merge
        //   ⇒ 目标文件永远是 .part0（deploy.ps1 同款隐患，只是它传的都是多块才没暴露 ✗）
        if parts > 1 { hs.add("X-Part: " + _str(i)) }
        string r = http_post(base + "/upload", seg, hs, 60000)
        if not has_ok(r) {
            print("      [FAIL] 第 " + _str(i) + " 块：" + r)
            _exit(1)
        }
        print("      块 " + _str(i + 1) + "/" + _str(parts) + " ok（" + _str(seg.byte_len()) + " B）")
    }
    int ms = _int(times.ms()) - t0
    print("      用时 " + _str(ms) + " ms")

    // ---- 4/5 合并（这里才带 name：merge 会先停同名进程，避免覆盖被占用的 exe）----
    print("[4/5] merge")
    if parts > 1 {
        Array[string] hsM = ["X-Token: " + token, "X-To: " + dest, "X-N: " + _str(parts)]
        if not uploadOnly { hsM.add("X-Name: " + name) }
        string m = http_post(base + "/merge", "", hsM, 60000)
        print("      " + m)
        if not has_ok(m) {
            print("[FAIL] merge 失败")
            _exit(1)
        }
    } else {
        print("      单块上传已直接落盘，无需求合并")
    }
    if uploadOnly {
        print("done（-uploadonly：已上传合并，未启动）")
        _exit(0)
    }

    // ---- 5/5 启动 + 轮询 ----
    print("[5/5] start " + dest)
    Array[string] hsS = ["X-Token: " + token, "X-Exe: " + dest]
    if startArgs != "" { hsS.add("X-Args: " + startArgs) }
    print("      " + http_post(base + "/start", "", hsS, 10000))

    Array[string] hsT = ["X-Token: " + token, "X-Name: " + name]
    string st = ""
    bool ready = false
    for 0 : 29 to i {
        st = http_get(base + "/status", hsT, 5000)
        if st.has("\"running\":true") { ready = true; break }
        th.sleep(300)
    }
    print("      status: " + st)
    if not ready {
        print("[WARN] 10 秒内没看到进程起来，看日志：" + dir_of(dest) + "\\logs\\")
    }
    if healthUrl != "" {
        string hh = http_get(healthUrl, [], 8000)
        if hh != "" { print("      health: " + hh) }
        else { print("      health: (无响应) " + healthUrl) }
    }
    if ready { print("done") } else { _exit(1) }
}
